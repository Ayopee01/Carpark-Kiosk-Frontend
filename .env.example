# Base URL ของ Backend (origin ไม่มี /api และไม่มี / ปิดท้าย) ฝังตอน build
# dev: ตั้งใน .env.local เช่น http://localhost:8080
# production: ตั้งเป็น GitHub Variable NEXT_PUBLIC_API_BASE_URL เช่น https://api.<domain> (ตั้งใน .env บน server ไม่มีผล)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# แสดงปุ่ม Dev Test เฉพาะ next dev
NEXT_PUBLIC_ENABLE_PAYMENT_TEST=false
